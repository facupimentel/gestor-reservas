PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/gestor_reservas
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_random
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Datos del admin inicial (usados por npm run seed)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@negocio.com
ADMIN_PASSWORD=admin1234

# Configuración inicial del negocio (usados por npm run seed)
BUSINESS_NAME=Mi Negocio

# WhatsApp vía Twilio (dejar vacío para desactivar el envío de mensajes)
# Obtenés estos valores en https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de WhatsApp habilitado en Twilio (el del sandbox mientras probás, o el tuyo aprobado en producción)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Código de país por defecto para completar números de clientes que vengan sin "+" (Argentina = 54)
DEFAULT_COUNTRY_CODE=54

# Zona horaria del negocio, en minutos de offset respecto a UTC (Argentina = -180, o sea UTC-3).
# Esto es lo que se usa para calcular la hora real de cada turno, sin importar en qué
# zona horaria esté corriendo el servidor (por ejemplo Render suele correr en UTC).
BUSINESS_UTC_OFFSET_MINUTES=-180
